# Copia este archivo a .env y rellena tus datos

# ==== PAYPAL (obligatorio para cobrar) ====
# Consíguelos en developers.paypal.com > Apps & Credentials > Create App
# PAYPAL_MODE=sandbox  -> para probar (usa cuentas de prueba)
# PAYPAL_MODE=live     -> para cobrar de verdad (usa tus credenciales reales)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ==== FRONTEND ====
# URL pública de tu web (la misma que pones en assets/js/config.js -> apiBaseUrl)
FRONT_URL=http://localhost:5500
ALLOWED_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
PORT=3000

# ==== EMAIL (factura automática) ====
# Necesitas un servidor SMTP. Ejemplo con Gmail (requiere App Password, no tu contraseña):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=tuemail@gmail.com
#   SMTP_PASS=tu-app-password (16 letras, la creas en tu cuenta Google > Seguridad > App passwords)
#   EMAIL_FROM=NEXUMO <tuemail@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ==== ALMACÉN DE PRODUCTOS (opcional) ====
# Carpeta donde están los archivos a entregar. Por defecto es la raíz de mi-tienda.
# STORAGE_ROOT=C:/Users/maru/Desktop/M/mi-tienda

# ==== REGISTRO EN DISCORD (visitas, compras, intentos de intrusión, soporte) ====
# Créala en tu canal de Discord: Editar canal > Integraciones > Webhooks > Nuevo webhook > Copiar URL
DISCORD_WEBHOOK_URL=

# ==== SOPORTE ====
# A dónde llegan los mensajes del formulario de contacto de la web
SUPPORT_EMAIL=astrihub@gmail.com
